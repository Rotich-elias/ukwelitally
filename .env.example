# Database
# Hosted Postgres connection string. On Vercel, set this via:
#   Vercel Dashboard -> Project -> Settings -> Environment Variables
# Or connect a provider (Neon, Supabase, Vercel Postgres) from the Storage tab,
# which sets DATABASE_URL automatically.
#
# The app also accepts POSTGRES_URL and PG_URL as fallbacks.
DATABASE_URL=postgresql://username:password@localhost:5432/ukwelitally

# Set to "require" when your provider requires TLS, or "false" to disable.
# Leave unset to auto-detect from the connection string.
# DATABASE_SSL=require

# Max connections per serverless instance. Keep this small so the provider's
# connection limit is not exhausted when many instances run concurrently.
# DATABASE_POOL_MAX=5

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-secret-key-here

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=/tmp/ukwelitally-uploads

# OCR API (optional - Google Vision API)
GOOGLE_VISION_API_KEY=your-api-key-here

# SMS Gateway (optional - for SMS fallback)
SMS_API_KEY=
SMS_SENDER_ID=UkweliTally

# ---------------------------------------------------------------------------
# File storage (production)
#
# The local filesystem is ephemeral on Vercel, so uploaded evidence would be
# lost between invocations. Connect one of the following for production:
#
# Option A - Vercel Blob (recommended on Vercel)
#   Connect the "Vercel Blob" store from the Storage tab. This sets
#   BLOB_READ_WRITE_TOKEN automatically.
#   BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
#
# Option B - S3 compatible (AWS S3, Cloudflare R2, Supabase Storage)
#   S3_BUCKET=ukwelitally-evidence
#   S3_REGION=auto
#   S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#   S3_ACCESS_KEY_ID=xxx
#   S3_SECRET_ACCESS_KEY=xxx
#   # Optional: base URL for publicly reachable files
#   S3_PUBLIC_URL=https://cdn.example.com
# ---------------------------------------------------------------------------
