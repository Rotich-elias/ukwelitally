# Database
# Hosted Postgres connection string. On Vercel, set this via:
#   Vercel Dashboard -> Project -> Settings -> Environment Variables
# Or connect a provider (Neon, Supabase, Vercel Postgres) from the Storage tab,
# which sets DATABASE_URL automatically.
#
# On Neon this should be the POOLED endpoint (the host name ends in
# "-pooler"). It is the connection the running application uses.
DATABASE_URL=

# Direct (non-pooled) connection string. Schema migrations, seeding and
# pg_dump must use this one: a transaction pooler (PgBouncer) loses session
# state between transactions, which breaks DDL such as CREATE EXTENSION.
# On Neon this is the same string as DATABASE_URL without "-pooler" in the
# host name. The migration runner (npm run db:migrate / db:bootstrap) prefers
# this variable and falls back to DATABASE_URL.
DATABASE_URL_DIRECT=

# Fallback names accepted by the application and the migration scripts when
# DATABASE_URL / DATABASE_URL_DIRECT are not set. Set at most one of them:
#   POSTGRES_URL             - pooled, used by the application
#   PG_URL                   - pooled, used by the application
#   POSTGRES_URL_NON_POOLING - direct (non-pooled), used by the scripts only
#   DIRECT_DATABASE_URL      - direct (non-pooled), used by the scripts only
# Leave these blank unless your provider requires them.
#
# The application only accepts POOLED endpoints. A non-pooling URL bypasses
# the provider's connection pooler, which is the opposite of what a serverless
# application needs, so it is used by the migration and seeding scripts only.
POSTGRES_URL=
PG_URL=
POSTGRES_URL_NON_POOLING=
DIRECT_DATABASE_URL=

# Set to "require" when your provider requires TLS, or "false" to disable.
# Leave unset to auto-detect from the connection string. Remote connections
# always require TLS; the migration runner refuses a remote connection that
# explicitly disables it or turns certificate verification off.
# DATABASE_SSL=require

# Max connections per serverless instance. Keep this small so the provider's
# connection limit is not exhausted when many instances run concurrently.
# DATABASE_POOL_MAX=5

# JWT Secret (generate with: openssl rand -base64 32)
#
# This value is REQUIRED in production. The placeholder below is recognised
# as a placeholder by the application: while it is in use, a random
# per-process secret is used instead, so no token can be forged but no session
# survives a restart or crosses instances.
JWT_SECRET=your-secret-key-here

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=/tmp/ukwelitally-uploads

# OCR API (optional - Google Vision API)
GOOGLE_VISION_API_KEY=your-api-key-here

# SMS Gateway (optional - for SMS fallback)
SMS_API_KEY=
SMS_SENDER_ID=UkweliTally

# ---------------------------------------------------------------------------
# File storage (production)
#
# The local filesystem is ephemeral on Vercel, so uploaded evidence would be
# lost between invocations. Connect one of the following for production:
#
# Option A - Vercel Blob (recommended on Vercel)
#   Connect the "Vercel Blob" store from the Storage tab. This sets
#   BLOB_READ_WRITE_TOKEN automatically.
#   BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
#
# Option B - S3 compatible (AWS S3, Cloudflare R2, Supabase Storage)
#   S3_BUCKET=ukwelitally-evidence
#   S3_REGION=auto
#   S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#   S3_ACCESS_KEY_ID=xxx
#   S3_SECRET_ACCESS_KEY=xxx
#   # Optional: base URL for publicly reachable files
#   S3_PUBLIC_URL=https://cdn.example.com
# ---------------------------------------------------------------------------
